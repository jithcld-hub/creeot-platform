@model CREEOT.WEB.Models.VerifyOtpViewModel
@{
    Layout = "_UserLayout";
    ViewBag.Title = "Verify Email — CREEOT";
}

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">
            <h2 class="text-center mb-2">Verify Your Email</h2>
            <p class="text-center text-muted mb-4">
                We sent a 6-digit code and a verification link to<br />
                <strong>@Model.Email</strong>
            </p>

            <form asp-action="VerifyEmailOtp" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3 text-center">
                    <label asp-for="OtpCode" class="form-label"></label>
                    <input asp-for="OtpCode" 
                           class="form-control text-center fs-3 letter-spacing-2" 
                           maxlength="6" 
                           placeholder="000000" 
                           autocomplete="one-time-code" 
                           autofocus />
                    <span asp-validation-for="OtpCode" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Verify Code
                </button>
            </form>

            <div class="text-center mt-3 text-muted">
                <small>Or simply click the verification button sent to your inbox.</small>
            </div>

            <hr />

            <div class="text-center">
                <form id="resendForm" asp-action="ResendOtp" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" class="btn btn-link btn-sm" id="resendBtn">
                        Didn't receive email? Resend
                    </button>
                </form>
                <div id="resendStatus" class="small mt-2"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('resendForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('resendBtn');
            const status = document.getElementById('resendStatus');
            btn.disabled = true;
            btn.textContent = 'Sending...';

            const formData = new FormData(this);
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            status.textContent = data.message;
            status.className = data.success ? 'small mt-2 text-success' : 'small mt-2 text-danger';

            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = "Didn't receive email? Resend";
            }, 30000); // 30s cooldown
        });
    </script>
}