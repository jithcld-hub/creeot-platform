@model CREEOT.WEB.Models.RegistrationViewModel
@{
    Layout = "_UserLayout";
    ViewBag.Title = "Create Free Account — CREEOT Escrow Platform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/creeot-auth.css" asp-append-version="true" />
}

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-brand-header">
            <br /><br />
        </div>

        <div class="auth-card">
            <!-- Social Sign-Up Quick Action -->
            <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="role" value="@Model.Role" id="googleAuthRole" />
                <button type="submit" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    Continue with Google
                </button>
            </form>

            <div class="auth-section-divider">
                <span>or register with email</span>
            </div>

            <form asp-controller="Account" asp-action="SignUp" method="post" id="signUpForm" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors text-danger mb-3"></div>

                <!-- Role Selector Tabs -->
                <div class="auth-role-switch">
                    <label class="auth-role-option @(Model.Role == CREEOT.WEB.Models.UserRole.Client ? "active" : "")" id="opt-client">
                        <input type="radio" asp-for="Role" value="@CREEOT.WEB.Models.UserRole.Client" id="role-client" />
                        <span>🏢 Brand / Business</span>
                    </label>
                    <label class="auth-role-option @(Model.Role == CREEOT.WEB.Models.UserRole.Influencer ? "active" : "")" id="opt-influencer">
                        <input type="radio" asp-for="Role" value="@CREEOT.WEB.Models.UserRole.Influencer" id="role-influencer" />
                        <span>🎬 Influencer / Creator</span>
                    </label>
                </div>
                <span asp-validation-for="Role" class="text-danger"></span>

                <!-- Core Identity Fields -->
                <div class="auth-two-cols">
                    <div class="form-group">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Rahul Sharma" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CountryCode" class="form-label"></label>
                        <select asp-for="CountryCode" asp-items="Model.AvailableCountries" class="form-control" id="countrySelect">
                            <option value="">Select Country</option>
                        </select>
                        <span asp-validation-for="CountryCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="auth-two-cols">
                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@domain.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+91 98765 43210" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <!-- Brand / Business Fields Panel -->
                <div id="clientFields" style="display: @(Model.Role == CREEOT.WEB.Models.UserRole.Client ? "block" : "none");">
                    <div class="auth-section-divider">
                        <span>Company & Billing Profile</span>
                    </div>

                    <div class="auth-two-cols">
                        <div class="form-group">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Apex Consumer Brands" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Industry" class="form-label"></label>
                            <select asp-for="Industry" class="form-control">
                                <option value="">Select Industry</option>
                                <option value="E-Commerce">E-Commerce & Retail</option>
                                <option value="Fashion & Beauty">Fashion & Apparel</option>
                                <option value="Tech & Electronics">Technology & Software</option>
                                <option value="FMCG & Food">Food & Beverages</option>
                                <option value="Travel & Hospitality">Travel & Hospitality</option>
                                <option value="Health & Fitness">Health & Fitness</option>
                            </select>
                            <span asp-validation-for="Industry" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="auth-two-cols">
                        <div class="form-group">
                            <label asp-for="WebsiteUrl" class="form-label"></label>
                            <input asp-for="WebsiteUrl" class="form-control" placeholder="https://company.com" />
                            <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TaxOrVatNumber" class="form-label"></label>
                            <input asp-for="TaxOrVatNumber" class="form-control" placeholder="GSTIN / TRN number" />
                            <span asp-validation-for="TaxOrVatNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Influencer / Creator Fields Panel -->
                <div id="influencerFields" style="display: @(Model.Role == CREEOT.WEB.Models.UserRole.Influencer ? "block" : "none");">
                    <div class="auth-section-divider">
                        <span>Creator Profile & Channels</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Handle" class="form-label"></label>
                        <input asp-for="Handle" class="form-control" placeholder="e.g. @@rahul_vlogs" />
                        <span asp-validation-for="Handle" class="text-danger"></span>
                    </div>

                    <div class="auth-two-cols">
                        <div class="form-group">
                            <label asp-for="PrimaryPlatform" class="form-label"></label>
                            <select asp-for="PrimaryPlatform" class="form-control">
                                <option value="">Select Platform</option>
                                <option value="instagram">Instagram</option>
                                <option value="youtube">YouTube</option>
                                <option value="tiktok">TikTok</option>
                            </select>
                            <span asp-validation-for="PrimaryPlatform" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PrimaryNiche" class="form-label"></label>
                            <select asp-for="PrimaryNiche" class="form-control">
                                <option value="">Select Primary Niche</option>
                                <option value="lifestyle">Lifestyle & Fashion</option>
                                <option value="tech">Technology & Gadgets</option>
                                <option value="travel">Travel & Tourism</option>
                                <option value="food">Food & Culinary</option>
                                <option value="fitness">Fitness & Wellness</option>
                            </select>
                            <span asp-validation-for="PrimaryNiche" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Account Security -->
                <div class="auth-section-divider">
                    <span>Account Security</span>
                </div>

                <div class="auth-two-cols">
                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Min. 8 characters" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <!-- Escrow Agreement Checkbox -->
                <div class="auth-check">
                    <input type="checkbox" asp-for="AgreeToTerms" id="AgreeToTerms" />
                    <label for="AgreeToTerms">
                        I agree to the <a asp-controller="Home" asp-action="Privacy" target="_blank">Terms & Privacy Policy</a> and accept the <a asp-controller="Home" asp-action="EscrowSecurity" target="_blank">Escrow Milestone Protection</a> terms.
                    </label>
                </div>
                <span asp-validation-for="AgreeToTerms" class="text-danger" style="margin-top:-14px; margin-bottom:18px; display:block;"></span>

                <button type="submit" class="btn-auth-submit" id="submitBtn">
                    @(Model.Role == CREEOT.WEB.Models.UserRole.Client ? "Register Brand Account" : "Register Creator Account")
                </button>
            </form>

            <div class="auth-footer-text">
                Already have an account? <a asp-action="Login" asp-controller="Account">Sign In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const clientOpt = document.getElementById('opt-client');
            const influencerOpt = document.getElementById('opt-influencer');
            const roleClientRadio = document.getElementById('role-client');
            const roleInfluencerRadio = document.getElementById('role-influencer');
            const clientFields = document.getElementById('clientFields');
            const influencerFields = document.getElementById('influencerFields');
            const submitBtn = document.getElementById('submitBtn');
            const googleAuthRole = document.getElementById('googleAuthRole');

            function toggleInputs(container, enable) {
                const inputs = container.querySelectorAll('input, select, textarea');
                inputs.forEach(el => {
                    el.disabled = !enable;
                });
            }

            function setRole(isClient) {
                if (isClient) {
                    clientOpt.classList.add('active');
                    influencerOpt.classList.remove('active');
                    roleClientRadio.checked = true;
                    clientFields.style.display = 'block';
                    influencerFields.style.display = 'none';
                    submitBtn.textContent = 'Register Brand Account';
                    if (googleAuthRole) googleAuthRole.value = 'Client';

                    toggleInputs(clientFields, true);
                    toggleInputs(influencerFields, false);
                } else {
                    influencerOpt.classList.add('active');
                    clientOpt.classList.remove('active');
                    roleInfluencerRadio.checked = true;
                    clientFields.style.display = 'none';
                    influencerFields.style.display = 'block';
                    submitBtn.textContent = 'Register Creator Account';
                    if (googleAuthRole) googleAuthRole.value = 'Influencer';

                    toggleInputs(clientFields, false);
                    toggleInputs(influencerFields, true);
                }
            }

            clientOpt.addEventListener('click', () => setRole(true));
            influencerOpt.addEventListener('click', () => setRole(false));

            // Set initial disabled state based on default selection
            setRole(@(Model.Role == CREEOT.WEB.Models.UserRole.Client ? "true" : "false"));
        });
    </script>
}