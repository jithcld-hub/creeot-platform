@using Microsoft.AspNetCore.Identity
@using CREEOT.WEB.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ApplicationUser? currentUser = null;
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Shared Ambient Atmosphere -->
    <div class="blue-atmosphere">
        <div class="mesh-blob-1"></div>
        <div class="mesh-blob-2"></div>
        <div class="ambient-grid"></div>
    </div>

    <!-- Sticky App Header -->
    <header class="navbar">
        <div class="container nav-inner">
            <a asp-controller="Home" asp-action="Index" class="logo-box">
                <div class="logo-symbol">
                    <svg viewBox="0 0 100 100" class="w-full h-full" fill="none" style="width:100%; height:100%;">
                        <path d="M 68 18 A 38 38 0 1 0 68 82" stroke="#3344ff" stroke-width="14" stroke-linecap="round" />
                        <line x1="50" y1="36" x2="82" y2="36" stroke="#00e5a3" stroke-width="8" stroke-linecap="round" />
                        <line x1="50" y1="50" x2="82" y2="50" stroke="#00e5a3" stroke-width="8" stroke-linecap="round" />
                        <line x1="50" y1="64" x2="82" y2="64" stroke="#00e5a3" stroke-width="8" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <div class="logo-name">CRE<span>E</span>OT</div>
                    <div class="logo-tagline">Influencers • Brands • Growth</div>
                </div>
            </a>

            <ul class="nav-menu">
                @if (User.IsInRole("Client"))
                {
                    <li class="nav-dropdown">
                        <a href="javascript:void(0)" class="dropdown-trigger">
                            Explore Creators <span class="arrow-down">▾</span>
                        </a>
                        <div class="dropdown-menu">
                            <a asp-controller="Explore" asp-action="Index" class="dropdown-item">
                                <div class="item-icon">✔</div>
                                <div>
                                    <strong>CREEOT Vetted Roster</strong>
                                    <p>In-house verified talent ready for escrow campaigns</p>
                                </div>
                            </a>

                            <div class="dropdown-divider"></div>

                            <a asp-controller="Explore" asp-action="Global" class="dropdown-item">
                                <div class="item-icon" style="color:#7d96ff;">&#127760;</div>
                                <div>
                                    <strong>Global Discovery Engine</strong>
                                    <p>Search 250M+ external social media profiles</p>
                                </div>
                            </a>
                        </div>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Creator" asp-action="Deals">My Deals & Escrow</a></li>
                    <li><a asp-controller="Creator" asp-action="Profile">Media Kit</a></li>
                }
                
                <li><a asp-controller="Home" asp-action="EscrowSecurity">Escrow Security</a></li>

                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Client"))
                {
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="SignUp">Account Registration</a></li>
                }
            </ul>

            @* <div class="nav-actions">
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Client"))
                {
                    <a asp-controller="Campaigns" asp-action="Create" class="btn-portal btn-mint">
                        + Launch Campaign
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn-portal btn-ghost">Sign Out</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-portal btn-ghost">Log In</a>
                    <a asp-controller="Account" asp-action="SignUp" class="btn-portal btn-mint">Sign Up Free</a>
                }
            </div> *@


            <div class="nav-actions">

            @if (SignInManager.IsSignedIn(User) && currentUser != null)
            {
                @if (User.IsInRole("Influencer"))
                {
                    <!-- Creator Profile Dropdown Pill -->
                    <div class="user-profile-menu">
                        <button class="profile-pill-trigger" id="profileDropdownBtn" aria-expanded="false">
@{
    string initials = "CR";
    if (!string.IsNullOrWhiteSpace(currentUser?.FullName))
    {
        var parts = currentUser.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : currentUser.FullName.Substring(0, Math.Min(2, currentUser.FullName.Length)).ToUpper();
    }
}
                                <span class="user-avatar creator-avatar">@initials</span>
                            <div class="user-meta-text">
                                <span class="user-name">@(currentUser.FullName ?? currentUser.UserName)</span>
                                <span class="role-badge creator-tag">Creator</span>
                            </div>
                            <span class="arrow-down">▾</span>
                        </button>

                        <div class="profile-dropdown-content" id="profileDropdownContent">
                            <div class="dropdown-header">
                                <p class="dropdown-user-email">@currentUser.Email</p>
                                <span class="status-indicator online">Verified Creator</span>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a asp-controller="Creator" asp-action="Dashboard" class="dropdown-item">📊 Creator Dashboard</a>
                            <a asp-controller="Creator" asp-action="Earnings" class="dropdown-item">💰 Escrow Wallet & Payouts</a>
                            <a asp-controller="Creator" asp-action="Settings" class="dropdown-item">⚙️ Account Settings</a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item logout-link">🚪 Sign Out</button>
                            </form>
                        </div>
                    </div>
                }
                else if (User.IsInRole("Client"))
                {
                    <a asp-controller="Campaigns" asp-action="Create" class="btn-portal btn-mint">+ Launch Campaign</a>
                    <!-- Client profile or sign out -->
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-portal btn-ghost">Sign Out</button>
                    </form>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-portal btn-ghost">Log In</a>
                <a asp-controller="Account" asp-action="SignUp" class="btn-portal btn-mint">Sign Up Free</a>
            }
            </div>
        </div>
    </header>

    <!-- Floating Toast for Login feedback -->
@if (TempData["ToastMessage"] != null)
{
    <div id="appToast" class="creeot-toast @(TempData["ToastType"]?.ToString() ?? "success")">
        <span class="toast-icon">✓</span>
        <span class="toast-message">@TempData["ToastMessage"]</span>
        <button class="toast-close" onclick="dismissToast()">&times;</button>
    </div>
}

    @RenderBody()

    <!-- Footer -->
    <footer>
        <div class="container footer-inner">
            <div class="logo-box">
                <div class="logo-symbol logo-symbol-sm">
                    <svg viewBox="0 0 100 100" fill="none" style="width:100%; height:100%;">
                        <path d="M 68 18 A 38 38 0 1 0 68 82" stroke="#3344ff" stroke-width="14" stroke-linecap="round" />
                        <line x1="50" y1="36" x2="82" y2="36" stroke="#00e5a3" stroke-width="8" stroke-linecap="round" />
                        <line x1="50" y1="50" x2="82" y2="50" stroke="#00e5a3" stroke-width="8" stroke-linecap="round" />
                        <line x1="50" y1="64" x2="82" y2="64" stroke="#00e5a3" stroke-width="8" stroke-linecap="round" />
                    </svg>
                </div>
                <span class="logo-name" style="font-size:1.15rem;">CRE<span>E</span>OT</span>
            </div>

            <div class="footer-legal">
                <p class="footer-copy">© @DateTime.Now.Year CREEOT Escrow Platform. All rights reserved.</p>
                <span style="color:var(--card-border);">•</span>
                <a asp-controller="Home" asp-action="Privacy">
                    Privacy Policy
                </a>
                <span style="color:var(--card-border);">•</span>
                <a asp-controller="Home" asp-action="EscrowSecurity">
                    Security & Compliance
                </a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<script>
    // Profile Dropdown Toggle
    const profileBtn = document.getElementById('profileDropdownBtn');
    const profileMenu = document.getElementById('profileDropdownContent');

    if (profileBtn && profileMenu) {
        profileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            profileMenu.classList.toggle('show');
        });

        document.addEventListener('click', (e) => {
            if (!profileMenu.contains(e.target) && !profileBtn.contains(e.target)) {
                profileMenu.classList.remove('show');
            }
        });
    }

    // Toast Auto-Dismiss after 4.5 seconds
    function dismissToast() {
        const toast = document.getElementById('appToast');
        if (toast) {
            toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(15px)';
            setTimeout(() => toast.remove(), 400);
        }
    }

    const toastElement = document.getElementById('appToast');
    if (toastElement) {
        setTimeout(dismissToast, 4500);
    }
</script>